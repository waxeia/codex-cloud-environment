{
  "name": "mimi-note-widget",
  "version": "1.0.0",
  "description": "一只会在桌面上悄悄变透明的可爱便签",
  "author": "Waxeia",
  "desktopName": "mimi-note-widget.desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "icons": "electron --no-sandbox --headless --disable-gpu --ozone-platform=headless scripts/generate-icons.js",
    "dist": "npm run icons && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mimi.note.widget",
    "productName": "咪咪便签",
    "publish": [],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "build/icons",
      "artifactName": "Mimi-Note-${version}.${ext}",
      "syncDesktopName": true
    }
  }
}
